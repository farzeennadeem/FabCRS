# FabDummy Exec Template: 
cd $job_results
$run_prefix

RESULTS_GROUP="$results_group"
RUN_FOLDER="$run"

echo "DEBUG job_results=$job_results"
echo "DEBUG results_group=$RESULTS_GROUP"
echo "DEBUG run=$RUN_FOLDER"

if [ -z "$RUN_FOLDER" ]; then
  echo "ERROR: run not provided. Use run=run_YYYYMMDD_HHMMSS"
  exit 1
fi

# Case A: job_results already points to .../results/<group>
if [ -d "$job_results/$RUN_FOLDER" ]; then
  RUN_DIR="$job_results/$RUN_FOLDER"

# Case B: job_results points to .../results (needs group)
elif [ -n "$RESULTS_GROUP" ] && [ -d "$job_results/$RESULTS_GROUP/$RUN_FOLDER" ]; then
  RUN_DIR="$job_results/$RESULTS_GROUP/$RUN_FOLDER"

else
  echo "ERROR: Run directory not found."
  echo "Tried:"
  echo "  $job_results/$RUN_FOLDER"
  if [ -n "$RESULTS_GROUP" ]; then
    echo "  $job_results/$RESULTS_GROUP/$RUN_FOLDER"
  fi
  echo "Available in job_results:"
  ls -1 "$job_results" || true
  exit 1
fi

echo "Generating dashboard in: $RUN_DIR"

# Ensure topology.yml is present in the run folder for the topology map
# Prefer the run's own topology.yml if already there.
if [ ! -f "$RUN_DIR/topology.yml" ]; then
  # Try copying from the scenario config that FabSim staged into the run folder
  if [ -f "$RUN_DIR/../topology.yml" ]; then
    cp "$RUN_DIR/../topology.yml" "$RUN_DIR/topology.yml"
    echo "Copied topology.yml from parent folder into run folder."
  elif [ -f "$job_results/topology.yml" ]; then
    cp "$job_results/topology.yml" "$RUN_DIR/topology.yml"
    echo "Copied topology.yml from job_results into run folder."
  else
    echo "WARNING: topology.yml not found to copy. Topology animation may not render."
  fi
else
  echo "topology.yml already present in run folder."
fi

# Run dashboard generator from plugin location
'$virtual_env_path'/bin/python3 gen_db.py \
  --run-dir "$RUN_DIR"
echo "Dashboard generation finished"
