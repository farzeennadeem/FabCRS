# FabDummy Exec Template: 
cd $job_results
$run_prefix

RESULTS_GROUP="$results_group"
RUN_FOLDER="$run"

echo "DEBUG job_results=$job_results"
echo "DEBUG results_group=$RESULTS_GROUP"
echo "DEBUG run=$RUN_FOLDER"

if [ -z "$RUN_FOLDER" ]; then
  echo "ERROR: run not provided. Use run=run_YYYYMMDD_HHMMSS"
  exit 1
fi

JOB_RESULTS="$job_results"

# If job_results looks like .../results/<some_group>, set RESULTS_ROOT to .../results
RESULTS_ROOT="$JOB_RESULTS"
if [ "$(basename "$JOB_RESULTS")" != "results" ]; then
  PARENT="$(dirname "$JOB_RESULTS")"
  if [ "$(basename "$PARENT")" = "results" ]; then
    RESULTS_ROOT="$PARENT"
  fi
fi

echo "DEBUG normalized RESULTS_ROOT=$RESULTS_ROOT"

# --- Resolve RUN_DIR ---
# Case A: job_results already points to the correct .../results/<group>
if [ -d "$JOB_RESULTS/$RUN_FOLDER" ] && [ "$(basename "$JOB_RESULTS")" = "$RESULTS_GROUP" ]; then
  RUN_DIR="$JOB_RESULTS/$RUN_FOLDER"

# Case B: use normalized results root: .../results/<group>/<run>
elif [ -n "$RESULTS_GROUP" ] && [ -d "$RESULTS_ROOT/$RESULTS_GROUP/$RUN_FOLDER" ]; then
  RUN_DIR="$RESULTS_ROOT/$RESULTS_GROUP/$RUN_FOLDER"

else
  echo "ERROR: Run directory not found."
  echo "Tried:"
  echo "  $JOB_RESULTS/$RUN_FOLDER  (only valid if job_results is the correct group)"
  echo "  $RESULTS_ROOT/$RESULTS_GROUP/$RUN_FOLDER"
  echo "Available groups in RESULTS_ROOT:"
  ls -1 "$RESULTS_ROOT" || true
  exit 1
fi

echo "Generating dashboard in: $RUN_DIR"

# Ensure topology.yml is present in the run folder for the topology map
# Prefer the run's own topology.yml if already there.
if [ ! -f "$RUN_DIR/topology.yml" ]; then
  # Try copying from the scenario config that FabSim staged into the run folder
  if [ -f "$RUN_DIR/../topology.yml" ]; then
    cp "$RUN_DIR/../topology.yml" "$RUN_DIR/topology.yml"
    echo "Copied topology.yml from parent folder into run folder."
  elif [ -f "$job_results/topology.yml" ]; then
    cp "$job_results/topology.yml" "$RUN_DIR/topology.yml"
    echo "Copied topology.yml from job_results into run folder."
  else
    echo "WARNING: topology.yml not found to copy. Topology animation may not render."
  fi
else
  echo "topology.yml already present in run folder."
fi

GEN_DB_SCRIPT="$fabcrs_location/gen_db.py"

if [ ! -f "$GEN_DB_SCRIPT" ]; then
    # Fallback to the local group folder just in case
    GEN_DB_SCRIPT="$RESULTS_ROOT/$RESULTS_GROUP/gen_db.py"
fi

echo "DEBUG using gen_db script: $GEN_DB_SCRIPT"

'$virtual_env_path'/bin/python3 "$GEN_DB_SCRIPT" \
  --run-dir "$RUN_DIR"